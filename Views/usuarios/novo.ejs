<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Novo Usuário | AuraFit</title>
  <link rel="stylesheet" href="/css/estilo-dash.css">
  <style>
    .alerta {
      padding: 14px 18px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-size: 0.95rem;
      font-weight: 500;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .alerta-erro {
      background-color: #fee2e2;
      color: #991b1b;
      border: 1px solid #f87171;
    }
    .alerta button {
      background: none;
      border: none;
      font-size: 1.2rem;
      cursor: pointer;
      color: inherit;
      line-height: 1;
    }
    .contador-chars {
      display: block;
      text-align: right;
      font-size: 0.8rem;
      color: #64748b;
      margin-top: 4px;
    }
  </style>
</head>

<body>

  <header class="topbar">
    <a href="/admin" class="logo-text">
      <img src="/img/landing/logo.png" alt="AuraFit Logo">
    </a>

    <ul class="nav-menu">
      <li><a href="/admin">Painel</a></li>
      <li><a href="/produtos">Produtos</a></li>
      <li><a href="/categorias">Categorias</a></li>
      <li><a href="/usuarios" class="ativo">Usuários</a></li>
      <li><a href="/vendas">Vendas</a></li>
      <li><a href="/itens_venda">Itens Venda</a></li>
    </ul>

    <div class="user-nav">
      <a href="/" class="btn-site">Ver Site</a>
      <a href="/logout" class="btn-sair">Sair</a>
    </div>
  </header>

  <main class="main-container">
    <section class="page-header">
      <div>
        <h1>Novo Usuário</h1>
        <p>Cadastre um novo administrador ou cliente na plataforma AuraFit.</p>
      </div>
      <a href="/usuarios" class="btn-cancelar" style="text-decoration: none;">← Voltar</a>
    </section>

    <div id="alertaUrlContainer"></div>

    <section class="card-tabela" style="padding: 28px;">
      <form action="/usuarios/novo" method="POST">
        <!-- nome VARCHAR(120) NOT NULL -->
        <div class="form-group">
          <label for="nome">Nome Completo</label>
          <input 
            type="text" 
            id="nome" 
            name="nome" 
            placeholder="Ex: Carlos Silva" 
            required 
            maxlength="120" 
            minlength="3" 
            autofocus
            oninput="atualizarContadores()">
          <small class="contador-chars" id="contadorNome">0 / 120 caracteres</small>
        </div>

        <!-- email VARCHAR(150) NOT NULL UNIQUE -->
        <div class="form-group" style="margin-top: 16px;">
          <label for="email">E-mail de Acesso</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            placeholder="carlos@aurafit.com.br" 
            required 
            maxlength="150"
            oninput="atualizarContadores()">
          <small class="contador-chars" id="contadorEmail">0 / 150 caracteres</small>
        </div>

        <!-- senha VARCHAR(255) NOT NULL -->
        <div class="form-group" style="margin-top: 16px;">
          <label for="senha">Senha</label>
          <input type="password" id="senha" name="senha" placeholder="••••••••" required maxlength="255" minlength="6">
        </div>

        <!-- tipo VARCHAR(20) NOT NULL -->
        <div class="form-group" style="margin-top: 16px;">
          <label for="perfil">Tipo de Usuário</label>
          <select id="perfil" name="perfil" required>
            <option value="cliente" selected>Cliente</option>
            <option value="admin">Admin</option>
          </select>
        </div>

        <!-- situacao INTEGER NOT NULL -->
        <div class="form-group" style="margin-top: 16px;">
          <label for="situacao">Status da Conta</label>
          <select id="situacao" name="situacao">
            <option value="1" selected>Ativo</option>
            <option value="0">Inativo</option>
          </select>
        </div>

        <div class="modal-footer" style="margin-top: 24px;">
          <a href="/usuarios" class="btn-cancelar" style="text-decoration: none;">Cancelar</a>
          <button type="submit" class="btn-primario">Salvar Usuário</button>
        </div>
      </form>
    </section>
  </main>

  <footer class="footer">© 2026 AuraFit - Sistema de Vendas Esportiva</footer>

  <script>
    function atualizarContadores() {
      const inputNome = document.getElementById('nome');
      const contadorNome = document.getElementById('contadorNome');
      if (inputNome.value.length > 120) {
        inputNome.value = inputNome.value.slice(0, 120);
      }
      contadorNome.innerText = `${inputNome.value.length} / 120 caracteres`;
      contadorNome.style.color = inputNome.value.length >= 120 ? '#dc2626' : '#64748b';

      const inputEmail = document.getElementById('email');
      const contadorEmail = document.getElementById('contadorEmail');
      if (inputEmail.value.length > 150) {
        inputEmail.value = inputEmail.value.slice(0, 150);
      }
      contadorEmail.innerText = `${inputEmail.value.length} / 150 caracteres`;
      contadorEmail.style.color = inputEmail.value.length >= 150 ? '#dc2626' : '#64748b';
    }

    (function exibirAlertaDaUrl() {
      const params = new URLSearchParams(window.location.search);
      const erroUrl = params.get('erro');
      const container = document.getElementById('alertaUrlContainer');

      if (erroUrl && container) {
        container.innerHTML = `
          <div class="alerta alerta-erro">
            <span>⚠️ ${erroUrl}</span>
            <button type="button" onclick="this.parentElement.remove()">&times;</button>
          </div>
        `;
        params.delete('erro');
        const novaQuery = params.toString();
        const novaUrl = window.location.pathname + (novaQuery ? '?' + novaQuery : '');
        window.history.replaceState({}, '', novaUrl);
      }
    })();
  </script>
</body>

</html>
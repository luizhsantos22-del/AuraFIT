<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestão de Itens Venda | AuraFit</title>
  <link rel="stylesheet" href="/css/estilo-dash.css">
  <style>
    .alerta {
      padding: 14px 18px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-size: 0.95rem;
      font-weight: 500;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .alerta-erro {
      background-color: #fee2e2;
      color: #991b1b;
      border: 1px solid #f87171;
    }
    .alerta-sucesso {
      background-color: #dcfce7;
      color: #166534;
      border: 1px solid #4ade80;
    }
    .alerta button {
      background: none;
      border: none;
      font-size: 1.2rem;
      cursor: pointer;
      color: inherit;
      line-height: 1;
    }
  </style>
</head>

<body>

  <header class="topbar">
    <a href="/admin" class="logo-text">
      <img src="/img/landing/logo.png" alt="AuraFit Logo">
    </a>

    <ul class="nav-menu">
      <li><a href="/admin">Painel</a></li>
      <li><a href="/produtos">Produtos</a></li>
      <li><a href="/categorias">Categorias</a></li>
      <li><a href="/usuarios">Usuários</a></li>
      <li><a href="/vendas">Vendas</a></li>
      <li><a href="/itens_venda" class="ativo">Itens Venda</a></li>
    </ul>

    <div class="user-nav">
      <a href="/" class="btn-site">Ver Site</a>
      <a href="/logout" class="btn-sair">Sair</a>
    </div>
  </header>

  <main class="main-container">
    <section class="page-header">
      <div>
        <h1>Gestão de Itens Venda</h1>
        <p>Gerencie os produtos e equipamentos detalhados em cada pedido da plataforma AuraFit.</p>
      </div>
      <button type="button" class="btn-primario" onclick="abrirModal()">+ Novo Item Venda</button>
    </section>

    <% 
      const mensagemErro = typeof erro !== 'undefined' && erro ? erro : '';
      const mensagemSucesso = typeof sucesso !== 'undefined' && sucesso ? sucesso : '';
    %>

    <% if (mensagemErro) { %>
      <div class="alerta alerta-erro" id="alertaMensagem">
        <span>⚠️ <%= mensagemErro %></span>
        <button type="button" onclick="this.parentElement.remove()">&times;</button>
      </div>
    <% } %>

    <% if (mensagemSucesso) { %>
      <div class="alerta alerta-sucesso" id="alertaMensagem">
        <span>✅ <%= mensagemSucesso %></span>
        <button type="button" onclick="this.parentElement.remove()">&times;</button>
      </div>
    <% } %>

    <div id="alertaUrlContainer"></div>

    <% 
      const listaItens = typeof itens !== 'undefined' ? itens : [];
      const listaVendas = typeof vendas !== 'undefined' ? vendas : [];
      const listaProdutos = typeof produtos !== 'undefined' ? produtos : [];

      const paginaAtual = typeof pagina !== 'undefined' ? Number(pagina) : 1;
      const totalPaginasAtual = typeof totalPaginas !== 'undefined' ? Number(totalPaginas) : 1;
      const buscaAtual = typeof busca !== 'undefined' ? busca : '';
      const ordemAtual = typeof ordem !== 'undefined' ? ordem : '';

      const totalRegistros = listaItens.length;
      const totalUnidades = listaItens.reduce((acc, item) => acc + Number(item.quantidade || 0), 0);
      const valorTotalItens = listaItens.reduce((acc, item) => acc + (Number(item.quantidade || 0) * Number(item.preco_unitario || 0)), 0);
    %>

    <section class="resumo-grid">
      <div class="resumo-card">
        <span>Registros de Itens</span>
        <strong><%= totalRegistros %></strong>
      </div>
      <div class="resumo-card">
        <span>Unidades Vendidas</span>
        <strong><%= totalUnidades %> un.</strong>
      </div>
      <div class="resumo-card">
        <span>Soma dos Itens</span>
        <strong>
          R$ <%= valorTotalItens.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
        </strong>
      </div>
    </section>

    <section class="card-tabela">
      <div class="toolbar">
        <input type="text" id="buscaItem" value="<%= buscaAtual %>" placeholder="Buscar por nº do pedido, cliente ou produto..." onkeyup="filtrarTabela()">
      </div>

      <table id="tabelaItens">
        <thead>
          <tr>
            <th>ID</th>
            <th>Pedido</th>
            <th>Cliente</th>
            <th>Produto</th>
            <th>Qtd.</th>
            <th>Preço Unit.</th>
            <th>Subtotal</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if (listaItens.length > 0) { %>
            <% listaItens.forEach(item => { %>
              <% const subtotal = Number(item.quantidade || 0) * Number(item.preco_unitario || 0); %>
              <tr>
                <td><strong>#<%= item.id %></strong></td>
                <td><strong>Pedido #<%= item.venda_id %></strong></td>
                <td><%= item.cliente_nome %></td>
                <td><strong><%= item.produto_nome %></strong></td>
                <td><%= item.quantidade %> un.</td>
                <td>R$ <%= Number(item.preco_unitario).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                <td>
                  <strong style="color: #175936;">
                    R$ <%= subtotal.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                  </strong>
                </td>
                <td>
                  <div class="acoes">
                    <button 
                      type="button" 
                      class="btn-acao btn-editar" 
                      onclick="editarItem('<%= item.id %>', '<%= item.venda_id %>', '<%= item.produto_id %>', '<%= item.quantidade %>', '<%= item.preco_unitario %>')">
                      Editar
                    </button>
                    <form action="/itens_venda/excluir/<%= item.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Deseja realmente excluir este item do pedido?');">
                      <button type="submit" class="btn-acao btn-excluir">Excluir</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" style="text-align: center; padding: 24px;">Nenhum item de venda registrado no sistema ainda.</td>
            </tr>
          <% } %>
        </tbody>
      </table>

      <div class="paginacao">
        <% if (paginaAtual > 1) { %>
          <a class="btn btn-secundario"
            href="/itens_venda?busca=<%= encodeURIComponent(buscaAtual) %>&ordem=<%= ordemAtual %>&pagina=<%= paginaAtual - 1 %>">
            Anterior
          </a>
        <% } %>

        <span class="paginacao-info">
          Página <strong><%= paginaAtual %></strong>
          de <strong><%= totalPaginasAtual %></strong>
        </span>

        <% if (paginaAtual < totalPaginasAtual) { %>
          <a class="btn btn-secundario"
            href="/itens_venda?busca=<%= encodeURIComponent(buscaAtual) %>&ordem=<%= ordemAtual %>&pagina=<%= paginaAtual + 1 %>">
            Próxima
          </a>
        <% } %>
      </div>
    </section>
  </main>

  <!-- MODAL CADASTRAR / EDITAR ITEM VENDA -->
  <div class="modal-overlay" id="modalItem">
    <div class="modal-box">
      <div class="modal-header">
        <h2 id="tituloModal">Novo Item Venda</h2>
        <button type="button" class="close-modal" onclick="fecharModal()">&times;</button>
      </div>

      <form id="formItem" action="/itens_venda/novo" method="POST">
        <!-- venda_id INTEGER NOT NULL -->
        <div class="form-group">
          <label for="venda_id">Pedido (Venda)</label>
          <select id="venda_id" name="venda_id" required>
            <option value="">Selecione o pedido...</option>
            <% listaVendas.forEach(v => { %>
              <option value="<%= v.id %>">Pedido #<%= v.id %> — <%= v.cliente_nome %></option>
            <% }) %>
          </select>
        </div>

        <!-- produto_id INTEGER NOT NULL -->
        <div class="form-group" style="margin-top: 12px;">
          <label for="produto_id">Produto / Equipamento</label>
          <select id="produto_id" name="produto_id" required onchange="atualizarPreco()">
            <option value="" data-preco="0">Selecione o produto...</option>
            <% listaProdutos.forEach(p => { %>
              <option value="<%= p.id %>" data-preco="<%= p.preco %>">
                <%= p.nome %> — R$ <%= Number(p.preco).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
              </option>
            <% }) %>
          </select>
        </div>

        <!-- quantidade INTEGER NOT NULL CHECK (quantidade > 0) -->
        <div class="form-group" style="margin-top: 12px;">
          <label for="quantidade">Quantidade</label>
          <input type="number" id="quantidade" name="quantidade" min="1" max="2147483647" value="1" required>
        </div>

        <!-- preco_unitario NUMERIC(10, 2) NOT NULL -->
        <div class="form-group" style="margin-top: 12px;">
          <label for="preco_unitario">Preço Unitário (R$)</label>
          <input type="number" id="preco_unitario" name="preco_unitario" step="0.01" min="0" max="99999999.99" placeholder="0.00" required>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-cancelar" onclick="fecharModal()">Cancelar</button>
          <button type="submit" class="btn-primario">Salvar Item</button>
        </div>
      </form>
    </div>
  </div>

  <footer class="footer">© 2026 AuraFit - Sistema de Vendas Esportiva</footer>

  <script>
    (function exibirAlertaDaUrl() {
      const params = new URLSearchParams(window.location.search);
      const erroUrl = params.get('erro');
      const sucessoUrl = params.get('sucesso');
      const container = document.getElementById('alertaUrlContainer');

      if (erroUrl && container) {
        container.innerHTML = `
          <div class="alerta alerta-erro">
            <span>⚠️ ${erroUrl}</span>
            <button type="button" onclick="this.parentElement.remove()">&times;</button>
          </div>
        `;
      } else if (sucessoUrl && container) {
        container.innerHTML = `
          <div class="alerta alerta-sucesso">
            <span>✅ ${sucessoUrl}</span>
            <button type="button" onclick="this.parentElement.remove()">&times;</button>
          </div>
        `;
      }

      if (erroUrl || sucessoUrl) {
        params.delete('erro');
        params.delete('sucesso');
        const novaQuery = params.toString();
        const novaUrl = window.location.pathname + (novaQuery ? '?' + novaQuery : '');
        window.history.replaceState({}, '', novaUrl);
      }
    })();

    function abrirModal() {
      document.getElementById('tituloModal').innerText = 'Novo Item Venda';
      document.getElementById('formItem').action = '/itens_venda/novo';
      document.getElementById('formItem').reset();
      document.getElementById('quantidade').value = '1';
      document.getElementById('modalItem').classList.add('aberto');
    }

    function editarItem(id, vendaId, produtoId, quantidade, preco) {
      document.getElementById('tituloModal').innerText = 'Editar Item Venda #' + id;
      document.getElementById('formItem').action = '/itens_venda/editar/' + id;
      document.getElementById('venda_id').value = vendaId;
      document.getElementById('produto_id').value = produtoId;
      document.getElementById('quantidade').value = quantidade;
      document.getElementById('preco_unitario').value = preco;
      document.getElementById('modalItem').classList.add('aberto');
    }

    function fecharModal() {
      document.getElementById('modalItem').classList.remove('aberto');
    }

    function atualizarPreco() {
      const select = document.getElementById('produto_id');
      const preco = parseFloat(select.options[select.selectedIndex].getAttribute('data-preco')) || 0;
      if (preco > 0) {
        document.getElementById('preco_unitario').value = preco.toFixed(2);
      }
    }

    function filtrarTabela() {
      const termo = document.getElementById('buscaItem').value.toLowerCase();
      document.querySelectorAll('#tabelaItens tbody tr').forEach(tr => {
        if (tr.children.length === 1) return;
        tr.style.display = tr.innerText.toLowerCase().includes(termo) ? '' : 'none';
      });
    }
  </script>
</body>

</html>
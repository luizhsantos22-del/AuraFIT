<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AuraFit - Login</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header>
    <nav class="main-nav">
      <a href="/" class="logo">
        <span class="logo-icon">▲</span> Aura<span>Fit</span>
      </a>
      <ul class="nav-links">
        <li><a href="/">Voltar ao Início</a></li>
      </ul>
    </nav>
  </header>

  <div class="auth-container">
    <h2>Acesso ao Painel Administrativo</h2>

    <% if (erro) { %>
      <div class="error-msg"><%= erro %></div>
    <% } %>

    <form action="/login" method="POST" class="auth-form">
      <div class="form-group">
        <label for="email">E-mail</label>
        <input type="email" id="email" name="email" required placeholder="seu@email.com">
      </div>

      <div class="form-group">
        <label for="senha">Senha</label>
        <input type="password" id="senha" name="senha" required placeholder="******">
      </div>

      <button type="submit" class="btn-submit">Entrar</button>
    </form>
  </div>

  <div class="footer-green-bar"></div>
  <footer class="footer-copyright">
    © 2026 AuraFit - Sistema de Vendas esportiva
  </footer>

</body>
</html>
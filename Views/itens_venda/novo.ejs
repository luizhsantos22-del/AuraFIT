<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Novo Item Venda | AuraFit</title>
  <link rel="stylesheet" href="/css/estilo-dash.css">
</head>
<body>

  <header class="topbar">
    <a href="/admin" class="logo-text">
       <img src="/img/landing/logo.png" alt="AuraFit Logo">
    </a>

    <ul class="nav-menu">
      <li><a href="/admin">Painel</a></li>
      <li><a href="/produtos">Produtos</a></li>
      <li><a href="/categorias">Categorias</a></li>
      <li><a href="/usuarios">Usuários</a></li>
      <li><a href="/vendas">Vendas</a></li>
      <li><a href="/itens_venda" class="ativo">Itens Venda</a></li>
    </ul>

    <div class="user-nav">
      <a href="/" class="btn-site">Ver Site</a>
      <a href="/logout" class="btn-sair">Sair</a>
    </div>
  </header>

  <main class="main-container">
    <section class="page-header">
      <div>
        <h1>Novo Item Venda</h1>
        <p>Adicione um produto a um pedido registrado na plataforma AuraFit.</p>
      </div>
      <a href="/itens_venda" class="btn-cancelar" style="text-decoration: none;">← Voltar</a>
    </section>

    <section class="card-tabela" style="padding: 28px;">
      <form action="/itens_venda/novo" method="POST">
        <div class="form-group">
          <label for="venda_id">Pedido (Venda)</label>
          <select id="venda_id" name="venda_id" required autofocus>
            <option value="">Selecione o pedido...</option>
            <% if (typeof vendas !== 'undefined' && vendas.length > 0) { %>
              <% vendas.forEach(v => { %>
                <option value="<%= v.id %>">
                  Pedido #<%= v.id %> — <%= v.cliente_nome %>
                </option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <div class="form-group" style="margin-top: 16px;">
          <label for="produto_id">Produto / Equipamento</label>
          <select id="produto_id" name="produto_id" required onchange="atualizarPreco()">
            <option value="" data-preco="0">Selecione o produto...</option>
            <% if (typeof produtos !== 'undefined' && produtos.length > 0) { %>
              <% produtos.forEach(p => { %>
                <option value="<%= p.id %>" data-preco="<%= p.preco %>">
                  <%= p.nome %> (Estoque: <%= p.estoque_atual %> un.)
                </option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <div class="form-group" style="margin-top: 16px;">
          <label for="quantidade">Quantidade</label>
          <input type="number" id="quantidade" name="quantidade" min="1" value="1" required>
        </div>

        <div class="form-group" style="margin-top: 16px;">
          <label for="preco_unitario">Preço Unitário (R$)</label>
          <input type="number" id="preco_unitario" name="preco_unitario" step="0.01" min="0" placeholder="0.00" required>
        </div>

        <div class="modal-footer" style="margin-top: 24px;">
          <a href="/itens_venda" class="btn-cancelar" style="text-decoration: none;">Cancelar</a>
          <button type="submit" class="btn-primario">Salvar Item</button>
        </div>
      </form>
    </section>
  </main>

  <footer class="footer">© 2026 AuraFit - Sistema de Vendas Esportiva</footer>

  <script>
    function atualizarPreco() {
      const select = document.getElementById('produto_id');
      const preco = parseFloat(select.options[select.selectedIndex].getAttribute('data-preco')) || 0;
      if (preco > 0) {
        document.getElementById('preco_unitario').value = preco.toFixed(2);
      }
    }
  </script>
</body>
</html>
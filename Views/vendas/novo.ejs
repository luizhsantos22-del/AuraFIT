<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nova Venda | AuraFit</title>
  <link rel="stylesheet" href="/css/estilo-dash.css">
  <style>
    .alerta {
      padding: 14px 18px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-size: 0.95rem;
      font-weight: 500;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .alerta-erro {
      background-color: #fee2e2;
      color: #991b1b;
      border: 1px solid #f87171;
    }
    .alerta button {
      background: none;
      border: none;
      font-size: 1.2rem;
      cursor: pointer;
      color: inherit;
      line-height: 1;
    }
  </style>
</head>

<body>

  <header class="topbar">
    <a href="/admin" class="logo-text">
      <img src="/img/landing/logo.png" alt="AuraFit Logo">
    </a>

    <ul class="nav-menu">
      <li><a href="/admin">Painel</a></li>
      <li><a href="/produtos">Produtos</a></li>
      <li><a href="/categorias">Categorias</a></li>
      <li><a href="/usuarios">Usuários</a></li>
      <li><a href="/vendas" class="ativo">Vendas</a></li>
      <li><a href="/itens_venda">Itens Venda</a></li>
    </ul>

    <div class="user-nav">
      <a href="/" class="btn-site">Ver Site</a>
      <a href="/logout" class="btn-sair">Sair</a>
    </div>
  </header>

  <main class="main-container">
    <section class="page-header">
      <div>
        <h1>Nova Venda</h1>
        <p>Registre um novo pedido de equipamentos esportivos na plataforma AuraFit.</p>
      </div>
      <a href="/vendas" class="btn-cancelar" style="text-decoration: none;">← Voltar</a>
    </section>

    <div id="alertaUrlContainer"></div>

    <section class="card-tabela" style="padding: 28px;">
      <form action="/vendas/novo" method="POST">
        <!-- usuario_id INTEGER NOT NULL -->
        <div class="form-group">
          <label for="usuario_id">Cliente</label>
          <select id="usuario_id" name="usuario_id" required autofocus>
            <option value="">Selecione um cliente...</option>
            <% if (typeof usuarios !== 'undefined' && usuarios.length > 0) { %>
              <% usuarios.forEach(u => { %>
                <option value="<%= u.id %>"><%= u.nome %></option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <!-- produto_id INTEGER NOT NULL -->
        <div class="form-group" style="margin-top: 16px;">
          <label for="produto_id">Produto / Equipamento</label>
          <select id="produto_id" name="produto_id" required onchange="atualizarTotal()">
            <option value="" data-preco="0" data-estoque="0">Selecione um produto...</option>
            <% if (typeof produtos !== 'undefined' && produtos.length > 0) { %>
              <% produtos.forEach(p => { %>
                <option value="<%= p.id %>" data-preco="<%= p.preco %>" data-estoque="<%= p.estoque_atual %>">
                  <%= p.nome %> — R$ <%= Number(p.preco).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> (Estoque: <%= p.estoque_atual %> un.)
                </option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <!-- quantidade INTEGER NOT NULL CHECK (quantidade > 0) -->
        <div class="form-group" style="margin-top: 16px;">
          <label for="quantidade">Quantidade</label>
          <input type="number" id="quantidade" name="quantidade" min="1" max="2147483647" value="1" required oninput="atualizarTotal()">
        </div>

        <!-- status VARCHAR(30) NOT NULL -->
        <div class="form-group" style="margin-top: 16px;">
          <label for="status">Status do Pedido</label>
          <select id="status" name="status" required>
            <option value="concluida" selected>Concluída (Pago)</option>
            <option value="pendente">Pendente</option>
            <option value="cancelada">Cancelada</option>
          </select>
        </div>

        <div style="margin-top: 20px; padding: 14px 18px; background-color: #f4f7f5; border-left: 4px solid #175936; border-radius: 6px; display: flex; justify-content: space-between; align-items: center;">
          <span style="font-size: 12.5px; font-weight: 700; text-transform: uppercase; color: #64748b;">Valor Total Estimado:</span>
          <strong id="valorTotalPreview" style="font-size: 18px; color: #175936;">R$ 0,00</strong>
        </div>

        <div class="modal-footer" style="margin-top: 24px;">
          <a href="/vendas" class="btn-cancelar" style="text-decoration: none;">Cancelar</a>
          <button type="submit" class="btn-primario">Salvar Venda</button>
        </div>
      </form>
    </section>
  </main>

  <footer class="footer">© 2026 AuraFit - Sistema de Vendas Esportiva</footer>

  <script>
    function atualizarTotal() {
      const select = document.getElementById('produto_id');
      const inputQtd = document.getElementById('quantidade');
      const opcao = select.options[select.selectedIndex];

      const preco = parseFloat(opcao.getAttribute('data-preco')) || 0;
      const estoque = parseInt(opcao.getAttribute('data-estoque')) || 0;

      inputQtd.max = estoque > 0 ? estoque : 2147483647;

      const qtd = parseInt(inputQtd.value) || 0;
      const total = preco * qtd;

      document.getElementById('valorTotalPreview').innerText = total.toLocaleString('pt-BR', {
        style: 'currency',
        currency: 'BRL'
      });
    }

    (function exibirAlertaDaUrl() {
      const params = new URLSearchParams(window.location.search);
      const erroUrl = params.get('erro');
      const container = document.getElementById('alertaUrlContainer');

      if (erroUrl && container) {
        container.innerHTML = `
          <div class="alerta alerta-erro">
            <span>⚠️ ${erroUrl}</span>
            <button type="button" onclick="this.parentElement.remove()">&times;</button>
          </div>
        `;
        params.delete('erro');
        const novaQuery = params.toString();
        const novaUrl = window.location.pathname + (novaQuery ? '?' + novaQuery : '');
        window.history.replaceState({}, '', novaUrl);
      }
    })();
  </script>
</body>

</html>
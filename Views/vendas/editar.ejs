<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar Venda #<%= venda.id %> | AuraFit</title>
  <link rel="stylesheet" href="/css/estilo-dash.css">
  <style>
    .alerta {
      padding: 14px 18px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-size: 0.95rem;
      font-weight: 500;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .alerta-erro {
      background-color: #fee2e2;
      color: #991b1b;
      border: 1px solid #f87171;
    }
    .alerta button {
      background: none;
      border: none;
      font-size: 1.2rem;
      cursor: pointer;
      color: inherit;
      line-height: 1;
    }
  </style>
</head>

<body>

  <header class="topbar">
    <a href="/admin" class="logo-text">
      <img src="/img/landing/logo.png" alt="AuraFit Logo">
    </a>

    <ul class="nav-menu">
      <li><a href="/admin">Painel</a></li>
      <li><a href="/produtos">Produtos</a></li>
      <li><a href="/categorias">Categorias</a></li>
      <li><a href="/usuarios">Usuários</a></li>
      <li><a href="/vendas" class="ativo">Vendas</a></li>
      <li><a href="/itens_venda">Itens Venda</a></li>
    </ul>

    <div class="user-nav">
      <a href="/" class="btn-site">Ver Site</a>
      <a href="/logout" class="btn-sair">Sair</a>
    </div>
  </header>

  <main class="main-container">
    <section class="page-header">
      <div>
        <h1>Editar Venda #<%= venda.id %></h1>
        <p>Atualize o status ou os dados do pedido registrado.</p>
      </div>
      <a href="/vendas" class="btn-cancelar" style="text-decoration: none;">← Voltar</a>
    </section>

    <div id="alertaUrlContainer"></div>

    <section class="card-tabela" style="padding: 28px;">
      <form action="/vendas/editar/<%= venda.id %>" method="POST">
        <!-- usuario_id INTEGER NOT NULL -->
        <div class="form-group">
          <label for="usuario_id">Cliente</label>
          <select id="usuario_id" name="usuario_id" required>
            <% if (typeof usuarios !== 'undefined' && usuarios.length > 0) { %>
              <% usuarios.forEach(u => { %>
                <option value="<%= u.id %>" <%= u.id === venda.usuario_id ? 'selected' : '' %>>
                  <%= u.nome %>
                </option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <!-- valor_total NUMERIC(10, 2) NOT NULL -->
        <div class="form-group" style="margin-top: 16px;">
          <label for="valor_total">Valor Total (R$)</label>
          <input type="number" id="valor_total" name="valor_total" step="0.01" min="0" max="99999999.99" value="<%= venda.valor_total %>" required>
        </div>

        <!-- status VARCHAR(30) NOT NULL -->
        <div class="form-group" style="margin-top: 16px;">
          <label for="status">Status do Pedido</label>
          <select id="status" name="status" required>
            <option value="concluida" <%= (venda.status || '').toLowerCase() === 'concluida' ? 'selected' : '' %>>Concluída</option>
            <option value="pendente" <%= (venda.status || '').toLowerCase() === 'pendente' ? 'selected' : '' %>>Pendente</option>
            <option value="cancelada" <%= (venda.status || '').toLowerCase() === 'cancelada' ? 'selected' : '' %>>Cancelada</option>
          </select>
        </div>

        <div class="modal-footer" style="margin-top: 24px;">
          <a href="/vendas" class="btn-cancelar" style="text-decoration: none;">Cancelar</a>
          <button type="submit" class="btn-primario">Salvar Alterações</button>
        </div>
      </form>
    </section>
  </main>

  <footer class="footer">© 2026 AuraFit - Sistema de Vendas Esportiva</footer>

  <script>
    (function exibirAlertaDaUrl() {
      const params = new URLSearchParams(window.location.search);
      const erroUrl = params.get('erro');
      const container = document.getElementById('alertaUrlContainer');

      if (erroUrl && container) {
        container.innerHTML = `
          <div class="alerta alerta-erro">
            <span>⚠️ ${erroUrl}</span>
            <button type="button" onclick="this.parentElement.remove()">&times;</button>
          </div>
        `;
        params.delete('erro');
        const novaQuery = params.toString();
        const novaUrl = window.location.pathname + (novaQuery ? '?' + novaQuery : '');
        window.history.replaceState({}, '', novaUrl);
      }
    })();
  </script>
</body>

</html>